# Accept the Microsoft license terms required by the Azure Event Hubs emulator.
ACCEPT_EULA=Y

# Event Hubs emulator entity used by both APIs.
EVENTHUB_NAME=batch-progress
EVENTHUB_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
EVENTHUB_CONNECTION_STRING_DOCKER=Endpoint=sb://eventhubs-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# Cosmos DB emulator settings. The key below is the well-known local emulator key.
COSMOSDB_ENDPOINT=https://localhost:8081/
COSMOSDB_ENDPOINT_DOCKER=https://cosmosdb:8081/
COSMOSDB_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEAemtxqYjhyFQJxqRQtPzkkmC0lZyV3gRvWz8rC/4YQzJ3lqSNC9s3w==
COSMOSDB_DATABASE=batch-processing
COSMOSDB_CONTAINER=batch-jobs
AZURE_COSMOS_EMULATOR_PARTITION_COUNT=3
AZURE_COSMOS_EMULATOR_IP_ADDRESS_OVERRIDE=127.0.0.1

# Azurite connection strings for host debugging and Docker networking.
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURITE_CONNECTION_STRING_DOCKER=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNoWfeYFt3sp+K2R4C8clEwHmDLzwfZ7s9yq8JgiLEtMA==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

# Empty by default so local development skips Azure Key Vault.
AZURE_KEY_VAULT_URI=
